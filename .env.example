# Copy to .env and fill in only what you need. Empty values use the default shown.
# .env is git-ignored: nothing you put here is ever committed.

# Anthropic API key. Needed only for npm run test:live and npm run record (default: none)
ANTHROPIC_API_KEY=

# Claude model for the live evaluation; use the same one in your Zap (default: claude-opus-5-5)
AI_MODEL=

# Set to 1 to run the live evaluation with a credential other than ANTHROPIC_API_KEY (default: empty)
LIVE_EVAL=
